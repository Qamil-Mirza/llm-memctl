# Combined pod v2 (Advisor, PROPOSAL c69f28e): Stage 2 held-out replication, then Stage 1 v2 DEV (S1t + S0), Qwen3-1.7B.
# Stage 1 held-out is NOT on this pod (it waits for the v2 dev gate to settle the primary setting).
# selfdoubt/s1s2_pod.sh runs stage2_pilot_pod.sh on the held-out rows (frozen readings R2.1-R2.4, report --label heldout)
# then stage0_full_pod.sh with RUNNER=selfdoubt/stage1_run.py (cut 0.9, plain payload, --sys s1t,s0; dev FULL reused).
# Needs the user's own approval line in the Executor pane.
# Timing (measured on m8hbjos8105hu9, A40): pilot 160 dev rows in 2,560 s after 20 s setup -> PILOT_S 3,300 s.
#   Stage 1 dev ran 3,750 requests in 2,021 s (incl. ~200 s max-token tail) + ~110 s load; v2 = 2 x 2,500 requests,
#   run one setting after the other -> ~2,800 s central + ~110 s load; step ceiling 3,900 s.
# Central ~1 h 35 min ($0.93); ceiling ~2 h 10 min ($1.28); hard DELETE at 9,750 s = 2 h 42.5 min ($1.60).
KEY_VAR=RUNPOD_API_KEY_2
EXPECT_EMAIL=qamilmirza@gmail.com
NAME=selfdoubt-s1s2-v2
POD_SCRIPT=selfdoubt/s1s2_pod.sh
OUTREL=runs/selfdoubt/s1s2v2_pod
OUT=runs/selfdoubt/s1s2v2_pod
L=runs/selfdoubt/s1s2v2_launch
ALLOW_SIBLING="runs/selfdoubt/s0c_pod1_launch runs/selfdoubt/s0c_pod2_launch"
HARD_S=9750
COPY_AT=9510
PRICE_H=0.59
USD_H=0.59
PILOT_S=3300
S2_SPLIT=heldout
S2_HELDOUT_CONFIRMED=1
ROWS=runs/selfdoubt/s2_heldout/rows.jsonl
ROWS_SHA=c3d849e879830c8da6d3d5d53b2a2a1efaf1dd63454fb2c98d84490b45e5f333
OFFSETS=0,32,128,end
S1_STEPS="s1v2_1p7b_gsm8k_dev|17|gsm8k|dev|250|3900"
S1_EXTRA="--cut 0.9 --payload plain --sys s1t,s0"
BUNDLE_EXTRA="runs/selfdoubt/s2_heldout/rows.jsonl runs/selfdoubt/s1s2v2_pod/s1/dev/full/Qwen3-1.7B/gen.jsonl"
