EXPECT_EMAIL=qamilmirza@gmail.com
POD_SCRIPT=selfdoubt/stage0_full_pod.sh
PRICE_H=0.59
USD_H=0.59
RUNNER=selfdoubt/stage1_run.py
EXTRA="--cut 0.9 --payload plain --sys s1 --arms N,V0,VG,I1,I2b"
NAME=selfdoubt-s1-rep
OUTREL=runs/selfdoubt/s1rep_pod
OUT=runs/selfdoubt/s1rep_pod
L=runs/selfdoubt/s1rep_launch
HARD_S=16900
COPY_AT=16660
STEPS="s1rep_1p7b_math500|17|math500|heldout|250|6400;s1rep_8b_gsm8k|8|gsm8k|heldout|250|1600;s1rep_8b_math500|8|math500|heldout|100|5300"
FULL_CHECK="runs/selfdoubt/s1rep_pod/heldout/full/Qwen3-1.7B/gen.jsonl|b4a9ac552ce32b78ee006de9d6cd4ffce783800d311be3db7c66e6e0b0153010;runs/selfdoubt/s1rep_pod/heldout/full/Qwen3-8B/gen.jsonl|60942b12d953004a092291147647a598fade7e3a70d2ed7d75c502fb6953d713"
