# Stage 2 pilot (PROPOSAL decision 8): Qwen3-1.7B, GSM8K DEV rows only (stage2_pilot.py select on pod 1's dev store),
# tests 1 and 2 by teacher-forced forwards (HF transformers 4.57.1, no vLLM). Sourced by pod_launch.sh / pod_wait.sh
# (laptop) and on the pod before stage2_pilot_pod.sh. Needs the user's own approval line in the Executor pane.
# Timing: measured on the laptop (Qwen3-0.6B bf16, RTX 3050, same 28 layers): 3.1 s per row-offset (89 forwards).
# A40 1.7B assumed the same, up to 2.5x slower: 160 rows x 3 offsets = 25 min central, 62 min ceiling; setup ~6 min.
# Central ~31 min ($0.30), ceiling ~68 min ($0.67), hard DELETE at 6,300 s = 1 h 45 min ($1.03). The run stops at its
# deadline between rows (classes interleaved, so a short run stays balanced) and the report runs on what finished.
KEY_VAR=RUNPOD_API_KEY_2
EXPECT_EMAIL=qamilmirza@gmail.com
NAME=selfdoubt-s2-pilot
POD_SCRIPT=selfdoubt/stage2_pilot_pod.sh
OUTREL=runs/selfdoubt/s2_pilot_pod
OUT=runs/selfdoubt/s2_pilot_pod
L=runs/selfdoubt/s2_pilot_launch
ALLOW_SIBLING="runs/selfdoubt/s0c_pod1_launch runs/selfdoubt/s0c_pod2_launch"
HARD_S=6300
COPY_AT=6060
PRICE_H=0.59
ROWS=runs/selfdoubt/s2_pilot/rows.jsonl
ROWS_SHA=FILL_AFTER_SELECT
OFFSETS=0,32,128
BUNDLE_EXTRA=runs/selfdoubt/s2_pilot/rows.jsonl
