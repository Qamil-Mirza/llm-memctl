# Copy this file to .env and fill in what you have. .env is never committed.
JEV_API_KEY=
# Only needed for gated Hugging Face models (the Qwen models are not gated).
HF_TOKEN=

# So that files the container writes belong to you and not to root.
# Fill these in with the output of `id -u` and `id -g`.
MEMCTL_UID=1000
MEMCTL_GID=1000
